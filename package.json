{
  "name": "resulogy",
  "version": "0.0.0",
  "description": "Generate a themeable, print-ready resume website from one YAML file.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s schema:check validate:resume build:app",
    "build:app": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1",
    "serve:test": "run-s build preview:test",
    "pdf": "tsx --tsconfig tsconfig.node.json scripts/export-pdf.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "schema:generate": "tsx --tsconfig tsconfig.app.json scripts/generate-resume-schema.ts",
    "schema:check": "tsx --tsconfig tsconfig.app.json scripts/generate-resume-schema.ts --check",
    "validate:resume": "tsx --tsconfig tsconfig.app.json scripts/validate-resume.ts",
    "check:text": "tsx --tsconfig tsconfig.node.json scripts/check-text-files.ts",
    "test:unit": "vitest run",
    "test:pdf-cli": "tsx --tsconfig tsconfig.node.json tests/cli/pdfCli.smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "run-s check:text schema:check validate:resume lint format:check type-check test:unit test:pdf-cli test:e2e build-only",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "run-s format:prettier format:text",
    "format:prettier": "prettier --write .",
    "format:text": "tsx --tsconfig tsconfig.node.json scripts/check-text-files.ts --write",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/vue": "^1.47.0",
    "simple-icons": "^16.32.0",
    "vue": "^3.5.42",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
